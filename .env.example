# AniList OAuth Configuration
# Get your Client ID from: https://anilist.co/settings/developer
# Create a new API client and use these settings:
# - Name: Your app name
# - Redirect URL: http://localhost:3000 (for local) or your deployed URL

NEXT_PUBLIC_ANILIST_CLIENT_ID=your_client_id_here

# Admin Secret (optional)
# Used to protect sensitive API routes like /api/db/init in production
# Generate a random string: openssl rand -hex 32
ADMIN_SECRET=

# Vercel Postgres Database
# These are automatically set when you connect a Vercel Postgres database
# Go to Vercel Dashboard > Storage > Create Database > Postgres
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
